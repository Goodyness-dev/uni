# LLM Primary (Gemini via OpenAI-compatible endpoint)
LLM_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gemini-2.0-flash

# LLM Fallback (Secondary provider via OpenAI SDK)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Pricing per million tokens (USD)
PRICE_PRIMARY_IN_PER_MTOK=0.30
PRICE_PRIMARY_OUT_PER_MTOK=2.50
PRICE_FALLBACK_IN_PER_MTOK=0.30
PRICE_FALLBACK_OUT_PER_MTOK=2.50

# neatlogs Tracing
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=
NEATLOGS_DASHBOARD_URL=https://app.neatlogs.com

# Crustdata (Optional live research)
CRUSTDATA_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
DEMO_INBOX_EMAIL=

# Service URLs
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Pipeline and demo controls
LIVE_RESEARCH=false
RETRY_SLEEP_SECONDS=1
DEMO_MODE=true
TODAY_OVERRIDE=
